# --- Required ---------------------------------------------------------------
# Local: mongodb://127.0.0.1:27017/travelbuddy
# Render: your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/travelbuddy

# Must be long and random. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# --- Maps (optional, but recommended) ---------------------------------------
# Both are free and neither needs a credit card.

# Geoapify — powers city autocomplete. 3,000 requests/day free.
# Sign up at https://myprojects.geoapify.com
# This key is PRIVATE: it is used only server-side, never sent to the browser.
GEOAPIFY_API_KEY=

# Restrict autocomplete to one country (ISO code), or leave blank for worldwide.
GEOCODE_COUNTRY=in

# MapTiler — powers the map tiles. 100,000 map loads/month free.
# Sign up at https://cloud.maptiler.com
# This key IS sent to the browser (tile URLs are fetched client-side), which is
# how MapTiler is designed to work. Restrict it by allowed origin in their
# dashboard so it cannot be used from other sites.
MAPTILER_API_KEY=
MAPTILER_STYLE=streets-v2

# --- Optional ---------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Only needed when the client is served from a different origin than the API.
# Comma-separated list. Leave blank for the single-service Render deployment.
CLIENT_URL=

# How long a login stays valid.
JWT_EXPIRES_IN=30d

# Email notifications. Without these, notifications are skipped (never fatal).
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@travelbuddy.com
